#!/bin/bash
# neon-osd volume up|down|mute · mic mute · brightness up|down — teclas de mídia com indicador na tela
idf="${XDG_RUNTIME_DIR:-/tmp}/neon-osd.id"
show() {  # título valor
  local id; id=$(cat "$idf" 2>/dev/null)
  id=$(notify-send -a neonos-osd -u low -t 1400 -h "int:value:$2" ${id:+-r "$id"} -p "$1") && echo "$id" > "$idf"
}
case "$1 ${2:-}" in
  "volume up")   wpctl set-mute @DEFAULT_AUDIO_SINK@ 0; wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ ;;
  "volume down") wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
  "volume mute") wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
  "mic mute")    wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
                 v=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@)
                 [[ $v == *MUTED* ]] && show "Microfone: mudo" 0 || show "Microfone: ligado" 100; exit ;;
  "brightness up")   brightnessctl -q set 5%+ ;;
  "brightness down") brightnessctl -q -n 1 set 5%- ;;
  *) echo "uso: neon-osd volume up|down|mute · mic mute · brightness up|down"; exit 1 ;;
esac
if [ "$1" = volume ]; then
  v=$(wpctl get-volume @DEFAULT_AUDIO_SINK@)
  pct=$(awk '{printf "%d", $2*100 + 0.5}' <<<"$v")
  [[ $v == *MUTED* ]] && show "Volume: mudo" 0 || show "Volume: $pct%" "$pct"
else
  pct=$(brightnessctl -m 2>/dev/null | cut -d, -f4 | tr -d %)
  show "Brilho: ${pct:-?}%" "${pct:-0}"
fi
