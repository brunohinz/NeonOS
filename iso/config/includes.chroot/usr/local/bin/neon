#!/usr/bin/env python3
"""neon — animações ASCII do NeonOS no terminal

uso: neon [efeito]        (qualquer tecla ou Ctrl+C sai)

  banner   logo animado do NeonOS
  rain     chuva digital
  donut    donut 3D girando
  fire     fogo neon
  plasma   plasma colorido
  tunnel   túnel infinito
  hack     invasão de sistema (encenação)
  all      todos em sequência
"""
import math, os, random, select, shutil, sys, time

try:
    import termios, tty
except ImportError:  # pragma: no cover
    termios = tty = None

ACC, HOT, YEL, WHITE, PURPLE = (0, 240, 255), (255, 42, 109), (245, 230, 99), (234, 252, 255), (122, 31, 162)
GL = "0123456789ABCDEF:;=+*<>|/"
LOGO = """███╗   ██╗███████╗ ██████╗ ███╗   ██╗ ██████╗ ███████╗
████╗  ██║██╔════╝██╔═══██╗████╗  ██║██╔═══██╗██╔════╝
██╔██╗ ██║█████╗  ██║   ██║██╔██╗ ██║██║   ██║███████╗
██║╚██╗██║██╔══╝  ██║   ██║██║╚██╗██║██║   ██║╚════██║
██║ ╚████║███████╗╚██████╔╝██║ ╚████║╚██████╔╝███████║
╚═╝  ╚═══╝╚══════╝ ╚═════╝ ╚═╝  ╚═══╝ ╚═════╝ ╚══════╝""".split("\n")
TRUECOLOR = os.environ.get("COLORTERM") in ("truecolor", "24bit") or os.environ.get("TERM", "").startswith("xterm")


def fg(c):
    if TRUECOLOR:
        return f"\x1b[38;2;{c[0]};{c[1]};{c[2]}m"
    r, g, b = c  # terminal de texto (tty): aproxima para 8 cores
    return "\x1b[1;36m" if b > 180 and g > 150 else "\x1b[1;35m" if r > 200 and b > 80 else "\x1b[1;33m" if r > 200 and g > 180 else "\x1b[31m" if r > 120 else "\x1b[34m"


def lerp(a, b, f):
    f = max(0.0, min(1.0, f))
    return tuple(int(a[i] + (b[i] - a[i]) * f) for i in range(3))


def grad(f, *stops):
    f = max(0.0, min(0.999, f)) * (len(stops) - 1)
    i = int(f)
    return lerp(stops[i], stops[i + 1], f - i)


class Screen:
    def __enter__(self):
        self.fd = sys.stdin.fileno()
        self.old = termios.tcgetattr(self.fd) if termios and os.isatty(self.fd) else None
        if self.old:
            tty.setcbreak(self.fd)
        sys.stdout.write("\x1b[?1049h\x1b[?25l\x1b[2J")
        return self

    def __exit__(self, *a):
        sys.stdout.write("\x1b[0m\x1b[?25h\x1b[?1049l")
        sys.stdout.flush()
        if self.old:
            termios.tcsetattr(self.fd, termios.TCSADRAIN, self.old)

    def key(self):
        return bool(self.old) and bool(select.select([sys.stdin], [], [], 0)[0]) and bool(os.read(self.fd, 64))

    @staticmethod
    def size():
        s = shutil.get_terminal_size((80, 24))
        return max(20, s.columns), max(8, s.lines - 1)


def render(grid, col):
    out = []
    for y, row in enumerate(grid):
        line, last = [], None
        for x, ch in enumerate(row):
            c = col[y][x]
            if ch != " " and c != last:
                line.append(fg(c))
                last = c
            line.append(ch)
        out.append("".join(line) + "\x1b[0m")
    return "\n".join(out)


def blank(W, H):
    return [[" "] * W for _ in range(H)], [[None] * W for _ in range(H)]


# ------------------------------------------------------------------ efeitos
def fx_rain(W, H, t, st):
    if "d" not in st:
        st["d"] = [[random.uniform(-H, H), random.uniform(.3, .9), random.randint(5, 22)] for _ in range(W)]
        st["g"] = [[random.choice(GL) for _ in range(W)] for _ in range(H)]
    grid, col = blank(W, H)
    for x, d in enumerate(st["d"]):
        d[0] += d[1]
        if d[0] - d[2] > H:
            d[:] = [random.uniform(-H / 2, 0), random.uniform(.3, .9), random.randint(5, 22)]
        for k in range(d[2]):
            y = int(d[0]) - k
            if 0 <= y < H:
                if random.random() < .03:
                    st["g"][y][x] = random.choice(GL)
                grid[y][x] = st["g"][y][x]
                col[y][x] = WHITE if k == 0 else lerp((0, 30, 40), ACC, 1 - k / d[2])
    return render(grid, col)


def fx_donut(W, H, t, st):
    grid, col = blank(W, H)
    z = [[0.0] * W for _ in range(H)]
    A, B = t * .9, t * .45
    cA, sA, cB, sB = math.cos(A), math.sin(A), math.cos(B), math.sin(B)
    K2 = 5
    K1 = min(W * .32, H * 2 * .32) * K2 / 3
    L = ".,-~:;=!*#$@"
    th = 0.0
    while th < 6.283:
        ct, stt = math.cos(th), math.sin(th)
        ph = 0.0
        while ph < 6.283:
            cp, sp = math.cos(ph), math.sin(ph)
            cx, cy = 2 + ct, stt
            x = cx * (cB * cp + sA * sB * sp) - cy * cA * sB
            y = cx * (sB * cp - sA * cB * sp) + cy * cA * cB
            ooz = 1 / (K2 + cA * cx * sp + cy * sA)
            xp, yp = int(W / 2 + K1 * ooz * x), int(H / 2 - K1 * ooz * y / 2)
            lum = cp * ct * sB - cA * ct * sp - sA * stt + cB * (cA * stt - ct * sA * sp)
            if 0 <= xp < W and 0 <= yp < H and lum > 0 and ooz > z[yp][xp]:
                z[yp][xp] = ooz
                li = min(11, int(lum * 8))
                grid[yp][xp] = L[li]
                col[yp][xp] = grad(li / 11, PURPLE, HOT, ACC)
            ph += .03
        th += .08
    return render(grid, col)


def fx_fire(W, H, t, st):
    if "f" not in st or len(st["f"]) != W * H:
        st["f"] = [0] * (W * H)
    f = st["f"]
    k = min(1.0, 36 / (H * .75))
    for x in range(W):
        f[(H - 1) * W + x] = 36 if random.random() < .9 else 24
    for y in range(1, H):
        for x in range(W):
            src = y * W + x
            p = f[src]
            if not p:
                f[src - W] = 0
                continue
            r = random.randint(0, 2)
            dst = src - W - r + 1
            if 0 <= dst < W * H:
                f[dst] = max(0, p - (1 if random.random() < k else 0))
    C = " .,:;-=+*#%@"
    grid, col = blank(W, H)
    for i, v in enumerate(f):
        if v >= 3:
            y, x = divmod(i, W)
            grid[y][x] = C[min(len(C) - 1, v * len(C) // 37)]
            col[y][x] = grad(v / 36, (5, 6, 10), (42, 6, 56), PURPLE, HOT, (255, 122, 61), YEL, (255, 255, 255))
    return render(grid, col)


def fx_plasma(W, H, t, st):
    C = " .:-=+*#%@"
    grid, col = blank(W, H)
    for y in range(H):
        for x in range(W):
            v = (math.sin(x * .09 + t) + math.sin(y * .18 - t * .8) + math.sin(x * .06 + y * .11 + t * .6)
                 + math.sin(math.sqrt((x - W / 2) ** 2 * .01 + (y - H / 2) ** 2 * .04) - t * 1.2))
            n = max(0, min(.999, (v + 4) / 8))
            grid[y][x] = C[int(n * 10)]
            col[y][x] = grad(n, (42, 6, 56), HOT, ACC)
    return render(grid, col)


def fx_tunnel(W, H, t, st):
    C = " .,:;+*#@"
    grid, col = blank(W, H)
    k = 2 / min(W, H * 2)
    for y in range(H):
        for x in range(W):
            X, Y = (x - W / 2) * k, (y - H / 2) * 2 * k
            r = math.hypot(X, Y) + 1e-3
            u, v, depth = .6 / r + t * 1.3, math.atan2(Y, X) / math.pi * 6 + t * .3, min(1, r * 1.1)
            if depth < .08:
                continue
            on = (int(u * 2) + int(v)) & 1
            grid[y][x] = C[min(8, int(depth * 9))] if on else ("." if depth > .45 else " ")
            col[y][x] = lerp((0, 20, 30), ACC, depth) if on else lerp((20, 0, 10), HOT, depth * .7)
    return render(grid, col)


def run(frame, seconds=None, fps=20):
    with Screen() as s:
        t0, (W, H), st = time.time(), s.size(), {}
        try:
            while not s.key() and (seconds is None or time.time() - t0 < seconds):
                W2, H2 = s.size()
                if (W2, H2) != (W, H):
                    W, H = W2, H2
                    st.clear()
                    sys.stdout.write("\x1b[2J")
                tf = time.time()
                sys.stdout.write("\x1b[H" + frame(W, H, tf - t0, st))
                sys.stdout.flush()
                time.sleep(max(0, 1 / fps - (time.time() - tf)))
        except KeyboardInterrupt:
            pass


# ------------------------------------------------------------------ banner e hack
def banner():
    W, _ = Screen.size()
    rows = LOGO if W >= 56 else ["N E O N // O S"]
    print()
    for i, line in enumerate(rows):
        f = i / max(1, len(rows) - 1)
        shown = ""
        for k in range(0, len(line) + 1, 6):  # efeito de "digitar" a linha
            shown = line[:k]
            sys.stdout.write("\r " + fg(grad(f, ACC, HOT)) + shown + "\x1b[0m")
            sys.stdout.flush()
            time.sleep(.004)
        sys.stdout.write("\r " + fg(grad(f, ACC, HOT)) + line + "\x1b[0m\n")
    info = os.uname()
    print(f" {fg((93, 122, 153))}{info.sysname} {info.release} · bash · digite {fg(ACC)}neon help{fg((93, 122, 153))} para animações\x1b[0m\n")


def hack():
    targets = ["MAINFRAME DA MEGACORP", "BANCO CENTRAL DE NEO-SP", "SATÉLITE ORBITAL K-7", "SERVIDOR DE DRONES"]
    target = random.choice(targets)
    steps = ["varrendo portas", "contornando ICE", "injetando daemon", "quebrando criptografia", "escalando privilégios", "copiando dados"]
    print(f"\n {fg(HOT)}▶ ALVO:{fg(ACC)} {target}\x1b[0m\n")
    try:
        for st in steps:
            for i in range(26):
                bar = "█" * i + "░" * (25 - i)
                hexs = " ".join(f"{random.randint(0, 255):02x}" for _ in range(6))
                sys.stdout.write(f"\r {fg(ACC)}{st:<24}{fg(HOT)}[{bar}]{fg((93, 122, 153))} {hexs}\x1b[0m")
                sys.stdout.flush()
                time.sleep(.018 + random.random() * .02)
            sys.stdout.write(f"\r {fg(ACC)}{st:<24}{fg((57, 255, 20))}[ OK ]{' ' * 46}\x1b[0m\n")
        print(f"\n {fg((57, 255, 20))}██ ACESSO CONCEDIDO ██\x1b[0m   {fg((93, 122, 153))}(é só uma encenação, nada foi invadido)\x1b[0m\n")
    except KeyboardInterrupt:
        print("\x1b[0m")


FX = {"rain": fx_rain, "donut": fx_donut, "fire": fx_fire, "plasma": fx_plasma, "tunnel": fx_tunnel}


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "help"
    if cmd == "banner":
        banner()
    elif cmd == "hack":
        hack()
    elif cmd in FX:
        run(FX[cmd], fps=15 if cmd in ("donut", "plasma", "tunnel") else 20)
    elif cmd == "all":
        for name in ("rain", "donut", "fire", "plasma", "tunnel"):
            run(FX[name], seconds=6, fps=15)
    else:
        print(__doc__)


if __name__ == "__main__":
    main()
