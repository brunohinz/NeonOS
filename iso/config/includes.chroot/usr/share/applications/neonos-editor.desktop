[Desktop Entry]
Type=Application
Name=Editor (NeonOS)
Comment=Abre textos no editor do NeonOS
Exec=neon-open --app editor %F
Icon=accessories-text-editor
MimeType=text/plain;text/markdown;text/x-log;text/x-python;text/x-shellscript;application/x-shellscript;application/json;application/xml;text/csv;text/x-csrc;text/x-chdr;text/x-c++src;text/css;text/javascript;application/javascript;application/x-yaml;application/toml;text/x-ini;
NoDisplay=true
