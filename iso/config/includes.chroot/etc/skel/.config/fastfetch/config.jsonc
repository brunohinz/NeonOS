// fastfetch do NeonOS — logo fantasma neon
{
  "logo": {
    "type": "file",
    "source": "/usr/share/neonos/logo.txt",
    "color": { "1": "cyan", "2": "red" },
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": " ❯ ",
    "color": { "keys": "red", "title": "cyan" }
  },
  "modules": [
    "title", "separator",
    { "type": "os", "key": "SISTEMA" },
    { "type": "kernel", "key": "KERNEL" },
    { "type": "uptime", "key": "ATIVO HÁ" },
    { "type": "packages", "key": "PACOTES" },
    { "type": "shell", "key": "SHELL" },
    { "type": "wm", "key": "COMPOSITOR" },
    { "type": "cpu", "key": "CPU" },
    { "type": "gpu", "key": "GPU" },
    { "type": "memory", "key": "MEMÓRIA" },
    { "type": "disk", "key": "DISCO" },
    { "type": "battery", "key": "BATERIA" },
    { "type": "localip", "key": "IP" },
    "break", "colors"
  ]
}
