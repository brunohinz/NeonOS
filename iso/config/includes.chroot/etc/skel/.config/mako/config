# notificações dos apps nativos — estilo neon do NeonOS
font=JetBrains Mono 10
background-color=#07080fee
text-color=#eafcff
border-color=#00f0ff
border-size=1
border-radius=0
progress-color=over #00f0ff55
padding=10,14
margin=8
outer-margin=0,12,56,0
width=360
max-visible=4
anchor=bottom-right
default-timeout=6000
icons=1
max-icon-size=40
format=<b>%s</b>\n%b

[urgency=critical]
border-color=#ff2a6d
default-timeout=12000

[app-name=neonos-osd]
anchor=bottom-center
outer-margin=0,0,90,0
width=260
format=<b>%s</b>
default-timeout=1400

[mode=do-not-disturb]
invisible=1

[mode=lock]
invisible=1
