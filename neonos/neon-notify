#!/usr/bin/env python3
"""neon-notify "título" ["texto"] [info|ok|err] — mostra uma notificação no NeonOS."""
import json, sys, urllib.request

if len(sys.argv) < 2:
    sys.exit(__doc__)
body = {"title": sys.argv[1], "body": sys.argv[2] if len(sys.argv) > 2 else "",
        "kind": sys.argv[3] if len(sys.argv) > 3 else "info"}
req = urllib.request.Request("http://127.0.0.1:8080/api/notify", json.dumps(body).encode(),
                             {"Content-Type": "application/json"})
urllib.request.urlopen(req, timeout=5)
