#!/usr/bin/env python3
"""neon-notify "título" ["texto"] [info|ok|err] [arquivo] — mostra uma notificação no NeonOS
                                            (com arquivo: clicar na notificação abre ele).
   neon-notify --ui EVENTO                  — envia um evento para a interface (ex.: start-menu)"""
import json, sys, urllib.request

if len(sys.argv) < 2:
    sys.exit(__doc__)
if sys.argv[1] == "--ui":
    url, body = "http://127.0.0.1:8080/api/ui", {"type": sys.argv[2] if len(sys.argv) > 2 else ""}
else:
    url = "http://127.0.0.1:8080/api/notify"
    body = {"title": sys.argv[1], "body": sys.argv[2] if len(sys.argv) > 2 else "",
            "kind": sys.argv[3] if len(sys.argv) > 3 else "info"}
    if len(sys.argv) > 4:
        body["open"] = sys.argv[4]
req = urllib.request.Request(url, json.dumps(body).encode(), {"Content-Type": "application/json"})
try:
    urllib.request.urlopen(req, timeout=5)
except OSError:
    sys.exit(1)
