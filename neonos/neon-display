#!/usr/bin/env python3
"""neon-display — monitores do NeonOS (os modos do Win+P)

  neon-display list            monitores e layout atual (JSON)
  neon-display mode MODO       pc | duplicate | extend | second
  neon-display primary NOME    escolhe o monitor principal (barra de tarefas e ícones)
  neon-display arrange A,B [row|column] [top|center|bottom]
                               posição física no "estender": A,B da esquerda para a direita
                               (row) ou de cima para baixo (column), e o alinhamento
  neon-display apply           reaplica o modo salvo (usado no login)
  neon-display shell-rule      recria o rc.xml: interface em todos os monitores + espaço da barra
"""
import json, os, re, subprocess, sys

STATE = os.path.expanduser("~/.config/neonos/display.json")
RC = os.path.expanduser("~/.config/labwc/rc.xml")
BEGIN, END = "<!-- neonos:shell-begin -->", "<!-- neonos:shell-end -->"
MODES = ("pc", "duplicate", "extend", "second")


def randr(*args):
    return subprocess.run(["wlr-randr", *args], capture_output=True, text=True, timeout=15)


def load_state():
    try:
        with open(STATE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {"mode": "extend", "primary": None}


def save_state(st):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE, "w") as f:
        json.dump(st, f)


def outputs():
    r = randr("--json")
    if r.returncode != 0:
        raise SystemExit("wlr-randr falhou: " + r.stderr.strip())
    return json.loads(r.stdout)


def mode_of(o, current=True):
    modes = o.get("modes") or []
    for key in (("current", "preferred") if current else ("preferred", "current")):
        for m in modes:
            if m.get(key):
                return m
    return modes[0] if modes else {"width": 1920, "height": 1080}


def logical_size(o):
    m = mode_of(o, current=o.get("enabled", False))
    w, h = m["width"], m["height"]
    if str(o.get("transform", "normal")) in ("90", "270", "flipped-90", "flipped-270"):
        w, h = h, w
    s = float(o.get("scale") or 1.0)
    return round(w / s), round(h / s)


def internal_first(outs):
    # telas de notebook (eDP/LVDS/DSI) são o "PC" por padrão
    return sorted(outs, key=lambda o: 0 if re.match(r"(eDP|LVDS|DSI)", o["name"]) else 1)


def pick_primary(outs, st):
    names = [o["name"] for o in outs]
    if st.get("primary") in names:
        return st["primary"]
    return internal_first(outs)[0]["name"] if outs else None


def layout():
    outs, st = outputs(), load_state()
    prim = pick_primary(outs, st)
    mons = []
    for o in outs:
        if not o.get("enabled"):
            continue
        w, h = logical_size(o)
        p = o.get("position") or {"x": 0, "y": 0}
        mons.append({"name": o["name"], "label": " ".join(x for x in (o.get("make"), o.get("model")) if x and x != "Unknown") or o["name"],
                     "x": p["x"], "y": p["y"], "w": w, "h": h, "primary": o["name"] == prim})
    if mons and not any(m["primary"] for m in mons):
        mons[0]["primary"] = True
    bbox = None
    if mons:
        x0, y0 = min(m["x"] for m in mons), min(m["y"] for m in mons)
        x1, y1 = max(m["x"] + m["w"] for m in mons), max(m["y"] + m["h"] for m in mons)
        bbox = {"x": x0, "y": y0, "w": x1 - x0, "h": y1 - y0}
    outs_info = [{"name": o["name"], "label": " ".join(x for x in (o.get("make"), o.get("model")) if x and x != "Unknown") or o["name"],
                  "w": logical_size(o)[0], "h": logical_size(o)[1]} for o in outs]
    order = [n for n in st.get("order") or [] if n in {o["name"] for o in outs}]
    order += [o["name"] for o in sorted(outs, key=lambda o: (o["name"] != prim, internal_first(outs).index(o))) if o["name"] not in order]
    return {"mode": st.get("mode", "extend"), "primary": prim, "connected": [o["name"] for o in outs],
            "outputs": outs_info, "order": order, "arrange": st.get("arrange", "row"), "align": st.get("align", "top"),
            "monitors": mons, "bbox": bbox}


def set_mode(mode):
    if mode not in MODES:
        raise SystemExit(f"modo inválido: {mode} (use {', '.join(MODES)})")
    outs, st = outputs(), load_state()
    prim = pick_primary(outs, st)
    others = [o for o in internal_first(outs) if o["name"] != prim]
    p = next((o for o in outs if o["name"] == prim), None)
    if p is None:
        raise SystemExit("nenhum monitor encontrado")
    if not others and mode != "pc":
        mode = "pc"  # só um monitor: não há o que estender
    args = []

    def on(o, x, y):
        args.extend(["--output", o["name"], "--on", "--pos", f"{x},{y}"])
        if not o.get("enabled"):
            args.append("--preferred")

    def off(o):
        args.extend(["--output", o["name"], "--off"])

    if mode == "pc":
        on(p, 0, 0); [off(o) for o in others]
    elif mode == "second":
        on(others[0], 0, 0); off(p); [off(o) for o in others[1:]]
    elif mode == "duplicate":
        on(p, 0, 0); [on(o, 0, 0) for o in others]
    else:  # extend: na ordem que o usuário arrumou (padrão: principal à esquerda)
        order = st.get("order") or []
        seq = sorted([p, *others], key=lambda o: order.index(o["name"]) if o["name"] in order else len(order))
        sizes = [logical_size(o) for o in seq]
        column = st.get("arrange") == "column"
        align = st.get("align", "top")
        span = max(h for w, h in sizes) if not column else max(w for w, h in sizes)
        pos = 0
        for o, (w, h) in zip(seq, sizes):
            own = h if not column else w
            off_ = 0 if align == "top" else (span - own) // 2 if align == "center" else span - own
            on(o, pos, off_) if not column else on(o, off_, pos)
            pos += w if not column else h
    r = randr(*args)
    if r.returncode != 0:
        raise SystemExit("wlr-randr falhou: " + r.stderr.strip())
    st["mode"], st["primary"] = mode, prim
    save_state(st)
    return mode


TEMPLATE = "/usr/share/neonos/labwc/rc.xml"
MANUAL = re.compile(r"<!--\s*neonos:manual\s*-->")
TASKBAR_H = 44


def fill(xml, name, body):
    """Troca o conteúdo entre <!-- neonos:NOME-begin --> e <!-- neonos:NOME-end -->."""
    b, e = f"<!-- neonos:{name}-begin -->", f"<!-- neonos:{name}-end -->"
    m = re.search(r"([ \t]*)" + re.escape(b) + r".*?" + re.escape(e), xml, flags=re.S)
    if not m:
        return None
    ind = m.group(1)
    return xml[:m.start()] + ind + b + "\n" + body + ind + e + xml[m.end():]


def shell_rule():
    """Recria o rc.xml a partir do modelo do NeonOS (atalhos novos chegam pelas atualizações),
    faz a janela da interface cobrir todos os monitores e reserva o espaço da barra de tarefas."""
    try:
        lay = layout()
    except SystemExit:
        lay = None
    bb = lay["bbox"] if lay else None
    prim = next((m["name"] for m in lay["monitors"] if m["primary"]), None) if lay else None
    if bb:
        rule = ('    <windowRule identifier="neonos-shell" serverDecoration="no" fixedPosition="yes">\n'
                f'      <action name="MoveTo" x="{bb["x"]}" y="{bb["y"]}" />\n'
                f'      <action name="ResizeTo" width="{bb["w"]}" height="{bb["h"]}" />\n'
                '    </windowRule>\n')
        margin = f'  <margin bottom="{TASKBAR_H}" output="{prim}" />\n' if prim else ""
    else:
        rule = ('    <windowRule identifier="neonos-shell" serverDecoration="no">\n'
                '      <action name="Maximize" />\n    </windowRule>\n')
        margin = ""
    try:
        with open(RC) as f:
            cur = f.read()
    except OSError:
        cur = ""
    base = cur
    if not MANUAL.search(cur):
        try:
            with open(TEMPLATE) as f:
                base = f.read()
        except OSError:
            pass
    if not base:
        return
    new = fill(base, "shell", rule)
    if new is None:   # rc.xml antigo, sem marcadores
        new = base.replace("<windowRules>", "<windowRules>\n    " + BEGIN + "\n" + rule + "    " + END, 1)
    new = fill(new, "margin", margin) or new
    if new != cur:
        os.makedirs(os.path.dirname(RC), exist_ok=True)
        with open(RC, "w") as f:
            f.write(new)
    subprocess.run(["labwc", "--reconfigure"], capture_output=True)


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "list"
    if cmd == "list":
        print(json.dumps(layout()))
    elif cmd == "mode":
        print(set_mode(sys.argv[2] if len(sys.argv) > 2 else ""))
    elif cmd == "primary":
        st = load_state(); st["primary"] = sys.argv[2]; save_state(st)
        set_mode(st.get("mode", "extend"))
    elif cmd == "arrange":
        names = [n for n in (sys.argv[2] if len(sys.argv) > 2 else "").split(",") if n]
        arr = sys.argv[3] if len(sys.argv) > 3 else "row"
        align = sys.argv[4] if len(sys.argv) > 4 else "top"
        if not names or arr not in ("row", "column") or align not in ("top", "center", "bottom"):
            raise SystemExit("uso: neon-display arrange A,B [row|column] [top|center|bottom]")
        st = load_state(); st.update(order=names, arrange=arr, align=align); save_state(st)
        print(set_mode("extend"))
    elif cmd == "apply":
        try:
            set_mode(load_state().get("mode", "extend"))
        except SystemExit as e:
            print(e, file=sys.stderr)
    elif cmd == "shell-rule":
        shell_rule()
    else:
        print(__doc__)


if __name__ == "__main__":
    main()
