#!/usr/bin/env python3
"""neon-open [--app files|editor|viewer|player] ARQUIVO... — abre arquivos e pastas na interface do NeonOS.
É o programa padrão de pastas, textos, imagens e mídia: quando outro app (Firefox, Steam...)
pede para abrir um desses, ele aparece no app certo do NeonOS."""
import json, os, subprocess, sys, urllib.parse, urllib.request

args, app = sys.argv[1:], None
if args[:1] == ["--app"] and len(args) > 1:
    app, args = args[1], args[2:]
for a in args or [os.path.expanduser("~")]:
    if a.startswith("file://"):
        a = urllib.parse.unquote(urllib.parse.urlparse(a).path)
    a = os.path.abspath(os.path.expanduser(a))
    body = json.dumps({"type": "open", "path": a, "app": app}).encode()
    try:
        urllib.request.urlopen(urllib.request.Request("http://127.0.0.1:8080/api/ui", body,
                                                      {"Content-Type": "application/json"}), timeout=5)
    except OSError:
        if os.path.isfile(a):   # interface fora do ar: tenta o próximo app que abre esse tipo
            subprocess.Popen(["gio", "open", a])
